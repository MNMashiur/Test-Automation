          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var responseBody = pm.response.json();\r\n\r\npm.test(\"Validate status code is 200\", () => {\r\n    pm.expect(200).to.eql(pm.response.code);\r\n});\r\n\r\npm.test(\"Validate only the requested (name) field changed\", () => {\r\n    pm.expect(responseBody.name).to.eql(\"Niran\");\r\n});\r\n"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
