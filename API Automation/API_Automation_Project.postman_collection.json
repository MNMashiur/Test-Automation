  "item": [
    {
      "name": "Q3_Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "\r\nvar responseBody = pm.response.json();\r\n\r\npm.test(\"Validate status code is 200\", () => {\r\n    pm.expect(200).to.eql(pm.response.code);\r\n});\r\n\r\nconst authToken = responseBody.token;\r\n\r\npm.test(\"Capture authToken\", () => {\r\n    pm.collectionVariables.set(\"authToken\", authToken);\r\n    pm.expect(pm.collectionVariables.get(\"authToken\")).to.eql(authToken);\r\n});\r\n"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "ajax",
            "value": "true"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-api-key",
            "value": "pub_252e9756aab871d7d6ac92a5a9417aa65a11068e1d36f13026c2f4551b17b87f"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"eve.holt@reqres.in\",\r\n  \"password\": \"cityslicka\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Q4_Get User",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var responseBody = pm.response.json();\r\n\r\npm.test(\"Validate status code is 200\", () => {\r\n    pm.expect(200).to.eql(pm.response.code);\r\n});\r\n\r\npm.test(\"Validate user name and email\", () => {\r\n    pm.expect(responseBody.data.first_name).to.eql(\"Janet\");\r\n    pm.expect(responseBody.data.email).to.eql(\"janet.weaver@reqres.in\");\r\n});\r\n"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "2"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Q5_Put Updated Profile",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var responseBody = pm.response.json();\r\n\r\npm.test(\"Validate status code is 200\", () => {\r\n    pm.expect(200).to.eql(pm.response.code);\r\n});\r\n\r\npm.test(\"Validate updatedAt timestamp exists\", () => {\r\n    pm.expect(responseBody.updatedAt).to.be.a(\"string\");\r\n    pm.expect(responseBody.updatedAt).to.not.be.empty;\r\n    pm.expect(new Date(responseBody.updatedAt).toISOString())\r\n        .to.eql(responseBody.updatedAt);\r\n});\r\n"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"name\": \"Mashiur Rahaman\",\r\n    \"job\": \"Software Engineer\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
